744  %macro drugdata(in =, out=);
745
746  /**************************************************************************/
747  /* STEP 1: Extract BPH drug records for the current drugissue file        */
748  /**************************************************************************/
749
750  *** Identify tamsulosin and comparator drug records;
751
752  %macro product (var=, atccode =, drugfile =);
753  proc sql;
754      CREATE TABLE codelist.&var._codes AS
755      SELECT *
756      FROM rawdata.product_aurum_atc
757      WHERE ATC LIKE &atccode;
758  quit;
759
760
761  proc sql;
762      CREATE TABLE output.&var._drugs AS
763      SELECT r.patid,
764             r.issuedate,
765             r.dosageid,
766             r.quantity,
767             r.duration,
768             r.prodcodeid,
769             c.atc,
770             c.strength
771      FROM &drugfile as r
772  inner join codelist.&var._codes as c on strip(c.prodcodeid) = strip(r.prodcodeid);
773  quit;
774
775
776  %mend product;
777
778  %product (var=tamsulosin, atccode = 'G04CA02', drugfile = &in);
779
780  %product (var=finasteride_mono1, atccode = 'G04CB01', drugfile = &in);
781  %product (var=finasteride_mono2, atccode = 'D11AX10', drugfile = &in);
782
783  %product (var=alfuzosin, atccode = 'G04CA01', drugfile = &in);
784
785
786
787
788
789  *** append drugs records for all drugs and create numeric exposure variable;
790
791  data appended_drugs;
792  set output.tamsulosin_drugs (in = a)
793  output.alfuzosin_drugs (in=b)
794  output.finasteride_mono1_drugs (in=c)
795  output.finasteride_mono2_drugs (in=d);
796  if a then exposure = 0;
797  else if b then exposure = 1;
798  else if c or d then exposure = 2;
799  run;
800
801
802  *** find mg value ;
803
804  data output.bph_drugs;
805      set appended_drugs;
806      length unit_found $20;
807
808      if not missing(strength) then do;
809          /* First number in the string (handles decimals) */
810          mg_value = input(scan(strength, 1,
810! 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ/'), best12.);
811
812          /* First unit word: letters immediately after the first number */
813          unit_found = scan(compress(strength, '0123456789. '), 1, '/');
814
815          /* Convert everything to mg */
816          if lowcase(unit_found) in ('microgram', 'micrograms', 'mcg') then mg_value = mg_value
816!  / 1000;
817          else if lowcase(unit_found) in ('gram', 'g') then mg_value = mg_value * 1000;
818          /* mg stays as-is */
819      end;
820
821      drop unit_found;
822  run;
823
824  /* HOW MANY PATIENTS */
825  proc sql;
826  select count(distinct patid) as "Step 1: bph drugs"n
827  from output.bph_drugs;
828  quit;
829
830
831  /****************************************************************************/
832  /* STEP 2: Generate treatment duration and mean daily dose in mg from common dosages file.*/
833  /****************************************************************************/
834
835  *** Import common_dosages file to extract daily dose variable;
836
837  proc sort data = codelist.common_dosages_aurum_dec2025;
838  by dosageid;
839  run;
840
841  proc sort data = output.bph_drugs;
842  by dosageid;
843  run;
844
845  data bph_dosages;
846  merge codelist.common_dosages_aurum_dec2025 (in=a) output.bph_drugs (in=b);
847  by dosageid;
848  if b;
849  run;
850
851  proc univariate data=bph_dosages;
852      var daily_dose;
853  run;
854
855  proc univariate data=bph_dosages;
856      var quantity;
857  run;
858
859  proc univariate data=bph_dosages;
860      var duration;
861  run;
862
863  *** calculate means daily dose;
864
865  data bph_dosages_mg;
866  set bph_dosages;
867  if daily_dose > 0 then mean_daily_dose = mg_value*daily_dose;
868  else mean_daily_dose = mg_value;
869  run;
870
871  *** Algorithm to determine reasonable assumed duration per prescription;
872  *** borrowed from ADEPT script with permission from Magdalena Gamba *;
873
874  data bph_tam_cleaning;
875  set bph_dosages_mg;
876  if daily_dose > 5 or daily_dose = . then daily_dose = 1;
877  if daily_dose = 0 then daily_dose = 0.5;
878  if quantity > 90 then quantity = 90;
879  if quantity > 0 and quantity ne . then assumed_duration = quantity/daily_dose;
880  if assumed_duration = . and duration ne . and duration > 0 and duration < 90 then
880! assumed_duration = duration;
881  if assumed_duration = . or assumed_duration < 1 then assumed_duration = 30;
882  run;
883
884  proc univariate data=bph_tam_cleaning;
885      var assumed_duration;
886  run;
887
888
889
890  /****************************************************************************/
891  /* STEP 3: Join with base_cohort so only patients in our main cohort remain.*/
892  /****************************************************************************/
893
894  *** Join cleaned prescription records with base cohort;
895
896  PROC SQL;
897  CREATE TABLE bph_tam AS
898      SELECT T.patid,
899  T.issuedate,
900  T.exposure,
901  T.atc,
902  T.dosageid,
903  T.quantity,
904  T.assumed_duration,
905  T.prodcodeid,
906  T.mg_value,
907  BC.regstartdate,
908  BC.baseline_dt
909      FROM bph_tam_cleaning AS T
910      INNER JOIN output.linked_bph_cohort AS BC ON BC.patid = T.patid
911  ORDER BY T.assumed_duration, T.patid, T.issuedate;
912  quit;
913
914
915
916  /* HOW MANY PATIENTS */
917  /* losing about 30 thousand*/
918  proc sql;
919  select count(distinct patid) as "Step 3: bphtam join to base"n
920  from bph_tam
921  quit;
922
923  /**************************************************************************/
924  /* STEP 4: Exclude 'PrevalentUsers'                                       */
925  /**************************************************************************/
926  /* 'Prevalent users' are those who had a drug prescription 1 year before   */
927  /* their baseline date. We identify them by comparing issue date with the  */
928  /* bph_dt in base_cohort. */
929  /* second step removes identified prevalent users from main dataset */
930
931  *** identify prevalent users;
932
933  proc sql;
934      create table PrevalentUsers as
935      select distinct patid
936      from bph_tam
937      where issuedate between intnx('year', baseline_dt, -1, 'same') and baseline_dt - 1;
938  quit;
939
940  /* HOW MANY PATIENTS */
941  proc sql;
942  select count(distinct patid) as "Step 4: prevalent user #"n
943  from PrevalentUsers
944  quit;
945
946
947  ***  We remove those in PrevalentUsers.;
948  ***  We only keep prescriptions dated on or after baseline.;
949
950  proc sql;
951      create table output.Rx_bph_PostStart as
952      select *
953      from bph_tam b
954      where not exists (
955          select 1
956          from PrevalentUsers p
957          where p.patid = b.patid
958          )
959      and issuedate >= baseline_dt
960      ;
961  quit;
962
963  /* HOW MANY PATIENTS */
964  proc sql;
965  select count(distinct patid) as "Step 4: removing prevalent users"n
966  from output.Rx_bph_PostStart
967  quit;
968
969
970  /**************************************************************************/
971  /* STEP 5: Identify earliest prescription date for each patient and exclude multi-drug
971! initiators         */
972  /**************************************************************************/
973  /* Finds the minimum (earliest) eventdate among the valid prescriptions.  */
974
975  proc sql;
976      create table output.BphEarliestDate as
977      select patid,
978             min(issuedate) as indexdate format = ddmmyy10.
979      from output.Rx_bph_PostStart
980      group by patid;
981  quit;
982
983
984  /* 1) We only keep rows where issuedate = indexdate.               */
985  /* 2) We call this 'EarliestRxAll'.                                       */
986  /* 3) If multiple rows share the same earliest date for a patient, we     */
987  /*    handle that in the subsequent step.                                 */
988  /* the earliest Rx will be used for cleaning in the subsequent steps, but then all records
988! will
989  be rejoined in the final step for creation of treatment episodes */
990
991  *** includes 2 multi-drug initiators;
992
993  proc sql;
994      create table output.EarliestRxBphAll as
995      select p.patid,
996             p.issuedate,
997             p.assumed_duration,
998             p.prodcodeid,
999             p.baseline_dt,
1000             e.indexdate,
1001             p.regstartdate,
1002             p.exposure,
1003             p.atc
1004      from output.BphEarliestDate as e
1005          left join output.Rx_bph_PostStart as p
1006          on p.patid = e.patid
1007  where p.issuedate = e.indexdate;
1008  quit;
1009
1010
1011  /*HOW MANY PATIENTS*/
1012  proc sql;
1013  select count(distinct patid) as "Step 5: First issue date"n
1014  from output.EarliestRxBphAll
1015  quit;
1016
1017  *** excluding multi-drug initiators;
1018
1019  proc sql;
1020      create table ExcludeMulti as
1021      select patid
1022      from output.EarliestRxBphAll
1023      group by patid
1024      having count(distinct exposure) > 1  /* More than 1 unique exposure => Exclude */
1025      ;
1026  quit;
1027
1028  proc sql;
1029      create table EarliestRxBph_Filtered as
1030      select *
1031      from output.EarliestRxBphAll
1032      where patid not in (select patid from ExcludeMulti);
1033  quit;
1034
1035
1036  /**************************************************************************/
1037  /* STEP 6: Exclude if run-in period is less than 365 days              */
1038  /**************************************************************************/
1039
1040  PROC SQL;
1041  create table EarliestRxBph_Filtered AS
1042  select *
1043  from EarliestRxBph_Filtered
1044  having indexdate - regstartdate > 365;
1045  quit;
1046
1047  /*HOW MANY PATIENTS*/
1048  proc sql;
1049  select count(distinct patid) as "Step 7: Washout exclusions"n
1050  from EarliestRxBph_Filtered
1051  quit;
1052
1053  **********;
1054  /*
1055  /**************************************************************************/
1056  /* STEP 7: Exclude if subarachnoid hemorrhage (aSAH) occurred before Rx   */
1057  /* (COMMENTED OUT until HES APC linkage is incorporated )                      */
1058  /**************************************************************************/
1059  /* If a patient's first aSAH date (HOSP ONLY) is before earliest Rx, we drop them.    */
1060  /* NOTE: DO NOT RUN UNTIL HES APC LINKAGE */
1061  /* NOTE: Jos's version requires both hospital and gp data so I have written new script
1061! myself for the timebeing*/
1062
1063  *proc sql;
1064  *CREATE TABLE EarliestRx_aSah_Exclusion AS
1065  SELECT d1.* , d2.patid, d2.aSAH_gp_dt
1066  FROM EarliestRx_washout as d1
1067  INNER JOIN output.linked_bph_cohort as d2
1068  ON d1.patid = d2.patid
1069      WHERE d2.aSAH_gp_dt > indexdate or d2.aSAH_gp_dt is NULL;
1070  *quit;
1071
1072  /*HOW MANY PATIENTS*/
1073  *proc sql;
1074  *select count(distinct patid) as "Step 8: prior aSAH"n
1075  from EarliestRx_aSah_Exclusion
1076  quit;
1077
1078
1079  /**************************************************************************/
1080  /* STEP 8: Retrieiving all treatment episodes from patients with exclusion criteria
1080! specified in steps 5 & 6   */
1081  /**************************************************************************/
1082
1083  /* FINAL PRODUCT */
1084
1085  proc sql;
1086  create table &out as
1087  select r.*
1088  from EarliestRxBph_Filtered as f
1089  left outer join output.Rx_bph_PostStart as r
1090  on f.patid = r.patid;
1091  quit;
1092
1093  %mend;

