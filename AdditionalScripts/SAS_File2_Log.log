373  %macro drugdata(in =, out=);
374
375  /**************************************************************************/
376  /* STEP 1: Extract BPH drug records for the current drugissue file        */
377  /**************************************************************************/
378
379  *** Identify tamsulosin and comparator drug records;
380
381  %macro product (var=, atccode =, drugfile =);
382  proc sql;
383      CREATE TABLE codelist.&var._codes AS
384      SELECT *
385      FROM rawdata.product_aurum_atc
386      WHERE ATC LIKE &atccode;
387  quit;
388
389
390  proc sql;
391      CREATE TABLE output.&var._drugs AS
392      SELECT r.patid,
393             r.issuedate,
394             r.dosageid,
395             r.quantity,
396             r.duration,
397             r.prodcodeid,
398             c.atc,
399             c.strength
400      FROM &drugfile as r
401  inner join codelist.&var._codes as c on strip(c.prodcodeid) = strip(r.prodcodeid);
402  quit;
403
404
405  %mend product;
406
407  %product (var=tamsulosin, atccode = 'G04CA02', drugfile = &in);
408
409  %product (var=finasteride_mono1, atccode = 'G04CB01', drugfile = &in);
410  %product (var=finasteride_mono2, atccode = 'D11AX10', drugfile = &in);
411  %product (var=finasteride_poly1, atccode = 'G04CB51', drugfile = &in);
412  %product (var=finasteride_poly2, atccode = 'G04CA55', drugfile = &in);
413
414  %product (var=alfuzosin, atccode = 'G04CA01', drugfile = &in);
415
416  %product (var=alfu_fini, atccode = 'G04CA51', drugfile = &in);
417
418
419
420
421
422  *** append drugs records for all drugs and create numeric exposure variable;
423
424  data appended_drugs;
425  set output.tamsulosin_drugs (in = a) output.alfuzosin_drugs (in=b)
425! output.finasteride_mono1_drugs (in=c)
426  output.finasteride_mono2_drugs (in=d) output.finisteride_poly1_drugs (in = e)
426! output.finisteride_poly2_drugs (in = f) output.alfu_fini_drugs (in = g);
427  if a then exposure = 0;
428  else if b then exposure = 1;
429  else if c or d or e or f then exposure = 2;
430  else if g then exposure = 99 ;
431  run;
432
433  data appended_drugs_2;
434  set appended_drugs;
435  where exposure ne 99;
436  run;
437
438  *** find mg value ;
439
440  data output.bph_drugs;
441      set appended_drugs_2;
442      length unit_found $20;
443
444      if not missing(strength) then do;
445          /* First number in the string (handles decimals) */
446          mg_value = input(scan(strength, 1,
446! 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ/'), best12.);
447
448          /* First unit word: letters immediately after the first number */
449          unit_found = scan(compress(strength, '0123456789. '), 1, '/');
450
451          /* Convert everything to mg */
452          if lowcase(unit_found) in ('microgram', 'micrograms', 'mcg') then mg_value = mg_value
452!  / 1000;
453          else if lowcase(unit_found) in ('gram', 'g') then mg_value = mg_value * 1000;
454          /* mg stays as-is */
455      end;
456
457      drop unit_found;
458  run;
459
460  /* HOW MANY PATIENTS */
461  proc sql;
462  select count(distinct patid) as "Step 1: bph drugs"n
463  from output.bph_drugs;
464  quit;
465
466
467  /****************************************************************************/
468  /* STEP 2: Generate treatment duration and mean daily dose in mg from common dosages file.*/
469  /****************************************************************************/
470
471  *** Import common_dosages file to extract daily dose variable;
472
473  proc sort data = codelist.common_dosages_aurum_dec2025;
474  by dosageid;
475  run;
476
477  proc sort data = output.bph_drugs;
478  by dosageid;
479  run;
480
481  data bph_dosages;
482  merge codelist.common_dosages_aurum_dec2025 (in=a) output.bph_drugs (in=b);
483  by dosageid;
484  if b;
485  run;
486
487  proc univariate data=bph_dosages;
488      var daily_dose;
489  run;
490
491  proc univariate data=bph_dosages;
492      var quantity;
493  run;
494
495  proc univariate data=bph_dosages;
496      var duration;
497  run;
498
499  *** calculate means daily dose;
500
501  data bph_dosages_mg;
502  set bph_dosages;
503  if daily_dose > 0 then mean_daily_dose = mg_value*daily_dose;
504  else mean_daily_dose = mg_value;
505  run;
506
507  *** Algorithm to determine reasonable assumed duration per prescription;
508  *** borrowed from ADEPT script with permission from Magdalena Gamba *;
509
510  data bph_tam_cleaning;
511  set bph_dosages_mg;
512  if daily_dose > 5 or daily_dose = . then daily_dose = 1;
513  if daily_dose = 0 then daily_dose = 0.5;
514  if quantity > 90 then quantity = 90;
515  if quantity > 0 and quantity ne . then assumed_duration = quantity/daily_dose;
516  if assumed_duration = . and duration ne . and duration > 0 and duration < 90 then
516! assumed_duration = duration;
517  if assumed_duration = . or assumed_duration < 1 then assumed_duration = 30;
518  run;
519
520  proc univariate data=bph_tam_cleaning;
521      var assumed_duration;
522  run;
523
524
525
526  /****************************************************************************/
527  /* STEP 3: Join with base_cohort so only patients in our main cohort remain.*/
528  /****************************************************************************/
529
530  *** Join cleaned prescription records with base cohort;
531
532  PROC SQL;
533  CREATE TABLE bph_tam AS
534      SELECT T.patid,
535  T.issuedate,
536  T.exposure,
537  T.atc,
538  T.dosageid,
539  T.quantity,
540  T.assumed_duration,
541  T.prodcodeid,
542  T.mg_value,
543  BC.regstartdate,
544  BC.baseline_dt
545      FROM bph_tam_cleaning AS T
546      INNER JOIN output.linked_bph_cohort AS BC ON BC.patid = T.patid
547  ORDER BY T.assumed_duration, T.patid, T.issuedate;
548  quit;
549
550
551
552  /* HOW MANY PATIENTS */
553  /* losing about 30 thousand*/
554  proc sql;
555  select count(distinct patid) as "Step 3: bphtam join to base"n
556  from bph_tam
557  quit;
558
559  /**************************************************************************/
560  /* STEP 4: Exclude 'PrevalentUsers'                                       */
561  /**************************************************************************/
562  /* 'Prevalent users' are those who had a drug prescription 1 year before   */
563  /* their baseline date. We identify them by comparing issue date with the  */
564  /* bph_dt in base_cohort. */
565  /* second step removes identified prevalent users from main dataset */
566
567  *** identify prevalent users;
568
569  proc sql;
570      create table PrevalentUsers as
571      select distinct patid
572      from bph_tam
573      where issuedate between intnx('year', baseline_dt, -1, 'same') and baseline_dt - 1;
574  quit;
575
576  /* HOW MANY PATIENTS */
577  proc sql;
578  select count(distinct patid) as "Step 4: prevalent user #"n
579  from PrevalentUsers
580  quit;
581
582
583  ***  We remove those in PrevalentUsers.;
584  ***  We only keep prescriptions dated on or after baseline.;
585
586  proc sql;
587      create table output.Rx_bph_PostStart as
588      select *
589      from bph_tam b
590      where not exists (
591          select 1
592          from PrevalentUsers p
593          where p.patid = b.patid
594          )
595      and issuedate >= baseline_dt
596      ;
597  quit;
598
599  /* HOW MANY PATIENTS */
600  proc sql;
601  select count(distinct patid) as "Step 4: removing prevalent users"n
602  from output.Rx_bph_PostStart
603  quit;
604
605
606  /**************************************************************************/
607  /* STEP 5: Identify earliest prescription date for each patient and exclude multi-drug
607! initiators         */
608  /**************************************************************************/
609  /* Finds the minimum (earliest) eventdate among the valid prescriptions.  */
610
611  proc sql;
612      create table output.BphEarliestDate as
613      select patid,
614             min(issuedate) as indexdate format = ddmmyy10.
615      from output.Rx_bph_PostStart
616      group by patid;
617  quit;
618
619
620  /* 1) We only keep rows where issuedate = indexdate.               */
621  /* 2) We call this 'EarliestRxAll'.                                       */
622  /* 3) If multiple rows share the same earliest date for a patient, we     */
623  /*    handle that in the subsequent step.                                 */
624  /* the earliest Rx will be used for cleaning in the subsequent steps, but then all records
624! will
625  be rejoined in the final step for creation of treatment episodes */
626
627  *** includes 2 multi-drug initiators;
628
629  proc sql;
630      create table output.EarliestRxBphAll as
631      select p.patid,
632             p.issuedate,
633             p.assumed_duration,
634             p.prodcodeid,
635             p.baseline_dt,
636             e.indexdate,
637             p.regstartdate,
638             p.exposure,
639             p.atc
640      from output.BphEarliestDate as e
641          left join output.Rx_bph_PostStart as p
642          on p.patid = e.patid
643  where p.issuedate = e.indexdate;
644  quit;
645
646
647  /*HOW MANY PATIENTS*/
648  proc sql;
649  select count(distinct patid) as "Step 5: First issue date"n
650  from output.EarliestRxBphAll
651  quit;
652
653  *** excluding multi-drug initiators;
654
655  proc sql;
656      create table ExcludeMulti as
657      select patid
658      from output.EarliestRxBphAll
659      group by patid
660      having count(distinct exposure) > 1  /* More than 1 unique exposure => Exclude */
661      ;
662  quit;
663
664  proc sql;
665      create table EarliestRxBph_Filtered as
666      select *
667      from output.EarliestRxBphAll
668      where patid not in (select patid from ExcludeMulti);
669  quit;
670
671
672  /**************************************************************************/
673  /* STEP 6: Exclude if run-in period is less than 365 days              */
674  /**************************************************************************/
675
676  PROC SQL;
677  create table EarliestRxBph_Filtered AS
678  select *
679  from EarliestRxBph_Filtered
680  having indexdate - regstartdate > 365;
681  quit;
682
683  /*HOW MANY PATIENTS*/
684  proc sql;
685  select count(distinct patid) as "Step 7: Washout exclusions"n
686  from EarliestRxBph_Filtered
687  quit;
688
689  **********;
690  /*
691  /**************************************************************************/
692  /* STEP 7: Exclude if subarachnoid hemorrhage (aSAH) occurred before Rx   */
693  /* (COMMENTED OUT until HES APC linkage is incorporated )                      */
694  /**************************************************************************/
695  /* If a patient's first aSAH date (HOSP ONLY) is before earliest Rx, we drop them.    */
696  /* NOTE: DO NOT RUN UNTIL HES APC LINKAGE */
697  /* NOTE: Jos's version requires both hospital and gp data so I have written new script myself
697!  for the timebeing*/
698
699  *proc sql;
700  *CREATE TABLE EarliestRx_aSah_Exclusion AS
701  SELECT d1.* , d2.patid, d2.aSAH_gp_dt
702  FROM EarliestRx_washout as d1
703  INNER JOIN output.linked_bph_cohort as d2
704  ON d1.patid = d2.patid
705      WHERE d2.aSAH_gp_dt > indexdate or d2.aSAH_gp_dt is NULL;
706  *quit;
707
708  /*HOW MANY PATIENTS*/
709  *proc sql;
710  *select count(distinct patid) as "Step 8: prior aSAH"n
711  from EarliestRx_aSah_Exclusion
712  quit;
713
714
715  /**************************************************************************/
716  /* STEP 8: Retrieiving all treatment episodes from patients with exclusion criteria specified
716!  in steps 5 & 6   */
717  /**************************************************************************/
718
719  /* FINAL PRODUCT */
720
721  proc sql;
722  create table &out as
723  select r.*
724  from EarliestRxBph_Filtered as f
725  left outer join output.Rx_bph_PostStart as r
726  on f.patid = r.patid;
727  quit;
728
729  %mend;

730
731  %drugdata(in=output.lildrugissue, out=output.bphdrugatc_test)
