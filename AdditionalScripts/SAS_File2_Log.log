12   /**************************************************************************/
13   /* STEP 1: Extract BPH drug records for the current drugissue file        */
14   /**************************************************************************/
15
16   *** Identify tamsulosin and comparator drug records;
17
18   %macro product (var=, atccode =, drugfile =);
19   proc sql;
20       CREATE TABLE codelist.&var._codes AS
21       SELECT *
22       FROM rawdata.product_aurum_atc
23       WHERE ATC LIKE &atccode;
24   quit;
25
26
27   proc sql;
28       CREATE TABLE output.&var._drugs AS
29       SELECT r.patid,
30              r.issuedate,
31              r.dosageid,
32              r.quantity,
33              r.duration,
34              r.prodcodeid,
35              c.atc,
36              c.strength
37       FROM &drugfile as r
38   inner join codelist.&var._codes as c on strip(c.prodcodeid) = strip(r.prodcodeid);
39   quit;
40
41
42   %mend product;
43
44   %product (var=tamsulosin, atccode = 'G04CA02', drugfile = &in);
45
46   %product (var=finasteride_mono1, atccode = 'G04CB01', drugfile = &in);
47   %product (var=finasteride_mono2, atccode = 'D11AX10', drugfile = &in);
48   %product (var=finasteride_poly1, atccode = 'G04CB51', drugfile = &in);
49   %product (var=finasteride_poly2, atccode = 'G04CA55', drugfile = &in);
50
51   %product (var=alfuzosin, atccode = 'G04CA01', drugfile = &in);
52
53   %product (var=alfu_fini, atccode = 'G04CA51', drugfile = &in);
54
55
56
57
58
59   *** append drugs records for all drugs and create numeric exposure variable;
60
61   data appended_drugs;
62   set output.tamsulosin_drugs (in = a) output.alfuzosin_drugs (in=b)
62 ! output.finasteride_mono1_drugs (in=c)
63   output.finasteride_mono2_drugs (in=d) output.finisteride_poly1_drugs (in = e)
63 ! output.finisteride_poly2_drugs (in = f) output.alfu_fini_drugs (in = g)*/;
64   if a then exposure = 0;
65   else if b then exposure = 1;
66   else if c or d or e or f then exposure = 2;
67   else if g then exposure = 99 ;
68   run;
69
70   data appended_drugs_2;
71   set appended_drugs;
72   where exposure ne 99;
73   run;
74
75   *** find mg value ;
76
77   data output.bph_drugs;
78       set appended_drugs_2;
79       length unit_found $20;
80
81       if not missing(strength) then do;
82           /* First number in the string (handles decimals) */
83           mg_value = input(scan(strength, 1,
83 ! 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ/'), best12.);
84
85           /* First unit word: letters immediately after the first number */
86           unit_found = scan(compress(strength, '0123456789. '), 1, '/');
87
88           /* Convert everything to mg */
89           if lowcase(unit_found) in ('microgram', 'micrograms', 'mcg') then mg_value = mg_value
89 !  / 1000;
90           else if lowcase(unit_found) in ('gram', 'g') then mg_value = mg_value * 1000;
91           /* mg stays as-is */
92       end;
93
94       drop unit_found;
95   run;
96
97   /* HOW MANY PATIENTS */
98   proc sql;
99   select count(distinct patid) as "Step 1: bph drugs"n
100  from output.bph_drugs;
101  quit;
102
103
104  /****************************************************************************/
105  /* STEP 2: Generate treatment duration and mean daily dose in mg from common dosages file.*/
106  /****************************************************************************/
107
108  *** Import common_dosages file to extract daily dose variable;
109
110  proc sort data = codelist.common_dosages_aurum_dec2025;
111  by dosageid;
112  run;
113
114  proc sort data = output.bph_drugs;
115  by dosageid;
116  run;
117
118  data bph_dosages;
119  merge codelist.common_dosages_aurum_dec2025 (in=a) output.bph_drugs (in=b);
120  by dosageid;
121  if b;
122  run;
123
124  proc univariate data=bph_dosages;
125      var daily_dose;
126  run;
127
128  proc univariate data=bph_dosages;
129      var quantity;
130  run;
131
132  proc univariate data=bph_dosages;
133      var duration;
134  run;
135
136  *** calculate means daily dose;
137
138  data bph_dosages_mg;
139  set bph_dosages;
140  if daily_dose > 0 then mean_daily_dose = mg_value*daily_dose;
141  else mean_daily_dose = mg_value;
142  run;
143
144  *** Algorithm to determine reasonable assumed duration per prescription;
145  *** borrowed from ADEPT script with permission from Magdalena Gamba *;
146
147  data bph_tam_cleaning;
148  set bph_dosages_mg;
149  if daily_dose > 5 or daily_dose = . then daily_dose = 1;
150  if daily_dose = 0 then daily_dose = 0.5;
151  if quantity > 90 then quantity = 90;
152  if quantity > 0 and quantity ne . then assumed_duration = quantity/daily_dose;
153  if assumed_duration = . and duration ne . and duration > 0 and duration < 90 then
153! assumed_duration = duration;
154  if assumed_duration = . or assumed_duration < 1 then assumed_duration = 30;
155  run;
156
157  proc univariate data=bph_tam_cleaning;
158      var assumed_duration;
159  run;
160
161
162
163  /****************************************************************************/
164  /* STEP 3: Join with base_cohort so only patients in our main cohort remain.*/
165  /****************************************************************************/
166
167  *** Join cleaned prescription records with base cohort;
168
169  PROC SQL;
170  CREATE TABLE bph_tam AS
171      SELECT T.patid,
172  T.issuedate,
173  T.exposure,
174  T.atc,
175  T.dosageid,
176  T.quantity,
177  T.assumed_duration,
178  T.prodcodeid,
179  T.mg_value,
180  BC.regstartdate,
181  BC.baseline_dt
182      FROM bph_tam_cleaning AS T
183      INNER JOIN output.linked_bph_cohort AS BC ON BC.patid = T.patid
184  ORDER BY T.assumed_duration, T.patid, T.issuedate;
185  quit;
186
187
188
189  /* HOW MANY PATIENTS */
190  /* losing about 30 thousand*/
191  proc sql;
192  select count(distinct patid) as "Step 3: bphtam join to base"n
193  from bph_tam
194  quit;
195
196  /**************************************************************************/
197  /* STEP 4: Exclude 'PrevalentUsers'                                       */
198  /**************************************************************************/
199  /* 'Prevalent users' are those who had a drug prescription 1 year before   */
200  /* their baseline date. We identify them by comparing issue date with the  */
201  /* bph_dt in base_cohort. */
202  /* second step removes identified prevalent users from main dataset */
203
204  *** identify prevalent users;
205
206  proc sql;
207      create table PrevalentUsers as
208      select distinct patid
209      from bph_tam
210      where issuedate between intnx('year', baseline_dt, -1, 'same') and baseline_dt - 1;
211  quit;
212
213  /* HOW MANY PATIENTS */
214  proc sql;
215  select count(distinct patid) as "Step 4: prevalent user #"n
216  from PrevalentUsers
217  quit;
218
219
220  ***  We remove those in PrevalentUsers.;
221  ***  We only keep prescriptions dated on or after baseline.;
222
223  proc sql;
224      create table output.Rx_bph_PostStart as
225      select *
226      from bph_tam b
227      where not exists (
228          select 1
229          from PrevalentUsers p
230          where p.patid = b.patid
231          )
232      and issuedate >= baseline_dt
233      ;
234  quit;
235
236  /* HOW MANY PATIENTS */
237  proc sql;
238  select count(distinct patid) as "Step 4: removing prevalent users"n
239  from output.Rx_bph_PostStart
240  quit;
241
242
243  /**************************************************************************/
244  /* STEP 5: Identify earliest prescription date for each patient and exclude multi-drug
244! initiators         */
245  /**************************************************************************/
246  /* Finds the minimum (earliest) eventdate among the valid prescriptions.  */
247
248  proc sql;
249      create table output.BphEarliestDate as
250      select patid,
251             min(issuedate) as indexdate format = ddmmyy10.
252      from output.Rx_bph_PostStart
253      group by patid;
254  quit;
255
256
257  /* 1) We only keep rows where issuedate = indexdate.               */
258  /* 2) We call this 'EarliestRxAll'.                                       */
259  /* 3) If multiple rows share the same earliest date for a patient, we     */
260  /*    handle that in the subsequent step.                                 */
261  /* the earliest Rx will be used for cleaning in the subsequent steps, but then all records
261! will
262  be rejoined in the final step for creation of treatment episodes */
263
264  *** includes 2 multi-drug initiators;
265
266  proc sql;
267      create table output.EarliestRxBphAll as
268      select p.patid,
269             p.issuedate,
270             p.assumed_duration,
271             p.prodcodeid,
272             p.baseline_dt,
273             e.indexdate,
274             p.regstartdate,
275             p.exposure,
276             p.atc
277      from output.BphEarliestDate as e
278          left join output.Rx_bph_PostStart as p
279          on p.patid = e.patid
280  where p.issuedate = e.indexdate;
281  quit;
282
283
284  /*HOW MANY PATIENTS*/
285  proc sql;
286  select count(distinct patid) as "Step 5: First issue date"n
287  from output.EarliestRxBphAll
288  quit;
289
290  *** excluding multi-drug initiators;
291
292  proc sql;
293      create table ExcludeMulti as
294      select patid
295      from output.EarliestRxBphAll
296      group by patid
297      having count(distinct exposure) > 1  /* More than 1 unique exposure => Exclude */
298      ;
299  quit;
300
301  proc sql;
302      create table EarliestRxBph_Filtered as
303      select *
304      from output.EarliestRxBphAll
305      where patid not in (select patid from ExcludeMulti);
306  quit;
307
308
309  /**************************************************************************/
310  /* STEP 6: Exclude if run-in period is less than 365 days              */
311  /**************************************************************************/
312
313  PROC SQL;
314  create table EarliestRxBph_Filtered AS
315  select *
316  from EarliestRxBph_Filtered
317  having indexdate - regstartdate > 365;
318  quit;
319
320  /*HOW MANY PATIENTS*/
321  proc sql;
322  select count(distinct patid) as "Step 7: Washout exclusions"n
323  from EarliestRxBph_Filtered
324  quit;
325
326  **********;
327  /*
328  /**************************************************************************/
329  /* STEP 7: Exclude if subarachnoid hemorrhage (aSAH) occurred before Rx   */
330  /* (COMMENTED OUT until HES APC linkage is incorporated )                      */
331  /**************************************************************************/
332  /* If a patient's first aSAH date (HOSP ONLY) is before earliest Rx, we drop them.    */
333  /* NOTE: DO NOT RUN UNTIL HES APC LINKAGE */
334  /* NOTE: Jos's version requires both hospital and gp data so I have written new script myself
334!  for the timebeing*/
335
336  *proc sql;
337  *CREATE TABLE EarliestRx_aSah_Exclusion AS
338  SELECT d1.* , d2.patid, d2.aSAH_gp_dt
339  FROM EarliestRx_washout as d1
340  INNER JOIN output.linked_bph_cohort as d2
341  ON d1.patid = d2.patid
342      WHERE d2.aSAH_gp_dt > indexdate or d2.aSAH_gp_dt is NULL;
343  *quit;
344
345  /*HOW MANY PATIENTS*/
346  *proc sql;
347  *select count(distinct patid) as "Step 8: prior aSAH"n
348  from EarliestRx_aSah_Exclusion
349  quit;
350
351
352  /**************************************************************************/
353  /* STEP 8: Retrieiving all treatment episodes from patients with exclusion criteria specified
353!  in steps 5 & 6   */
354  /**************************************************************************/
355
356  /* FINAL PRODUCT */
357
358  proc sql;
359  create table &out as
360  select r.*
361  from EarliestRxBph_Filtered as f
362  left outer join output.Rx_bph_PostStart as r
363  on f.patid = r.patid;
364  quit;
365
366  %mend;

