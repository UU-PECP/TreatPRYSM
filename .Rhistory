# ---------------------------------------------------------
# 1. Set up function
# ---------------------------------------------------------
run_ps_match_pipeline <- function(df, m = 5, seed = 123, caliper = 0.2) {
imputed <- mice(df, m = m, method = 'pmm', seed = seed)
ps_formula <- tamsulosin ~ age_at_index + acidosis + aids + alzheimers_disease +
cancer + copd + stroke + rheum_disease + diabetes + heart_failure +
hypercholesterolaemia + hypertension + liver_failure + nephrolith + paralysis +
peptic_ulcer + pvd + ckd + bmi_value + smk_status
# match within each imputation -> mimids object
matched <- matchthem(ps_formula,
datasets    = imputed,
approach    = "within",
method      = "nearest",
distance    = "glm",
link        = "logit",
ratio       = 1,
caliper     = caliper,
std.caliper = TRUE)
cox_fit_crude <- with(matched,
coxph(Surv(fu_days, aSAH) ~ tamsulosin),
cluster = TRUE)
#Incidence rates
summary_data <- matched %>%
group_by(tamsulosin) %>%
summarise(
total_cases = sum(aSAH),
total_follow_up = sum(fu_days),
total_follow_up_years = sum(fu_days) / 365.25,
median_fu_days = median(fu_days),
)
summary_data <- summary_data %>%
mutate(
incidence_rate = (total_cases / total_follow_up_years) * 1000
)
sink("amlodipine_pp_incidence.txt")
print(summary_data)
sink()
list(imputed        = imputed,
matched        = matched,
cox_fit_crude  = cox_fit_crude,
cox_pool_crude = pool(cox_fit_crude),
summary_data = summary_data)
}
run_ps_match_pipeline <- function(df, m = 5, seed = 123, caliper = 0.2) {
imputed <- mice(df, m = m, method = 'pmm', seed = seed)
ps_formula <- tamsulosin ~ age_at_index + acidosis + aids + alzheimers_disease +
cancer + copd + stroke + rheum_disease + diabetes + heart_failure +
hypercholesterolaemia + hypertension + liver_failure + nephrolith + paralysis +
peptic_ulcer + pvd + ckd + bmi_value + smk_status
# match within each imputation -> mimids object
matched <- matchthem(ps_formula,
datasets    = imputed,
approach    = "within",
method      = "nearest",
distance    = "glm",
link        = "logit",
ratio       = 1,
caliper     = caliper,
std.caliper = TRUE)
cox_fit_crude <- with(matched,
coxph(Surv(fu_days, aSAH) ~ tamsulosin),
cluster = TRUE)
#Incidence rates
summary_data <- matched %>%
group_by(tamsulosin) %>%
summarise(
total_cases = sum(aSAH),
total_follow_up = sum(fu_days),
total_follow_up_years = sum(fu_days) / 365.25,
median_fu_days = median(fu_days),
)
summary_data <- summary_data %>%
mutate(
incidence_rate = (total_cases / total_follow_up_years) * 1000
)
list(imputed        = imputed,
matched        = matched,
cox_fit_crude  = cox_fit_crude,
cox_pool_crude = pool(cox_fit_crude),
summary_data = summary_data)
}
#---------------------------------------
#Running the function
#---------------------------------------
alf_ref <- df %>% filter(exposure == 1 | exposure == 2)
fin_ref <- df %>% filter(exposure == 1 | exposure == 3)
alf_results <- run_ps_match_pipeline(alf_ref)
alf_hr <- tbl_regression(alf_results$cox_fit_crude, exponentiate = TRUE)
run_ps_match_pipeline <- function(df, m = 5, seed = 123, caliper = 0.2) {
#Incidence rates
summary_data <- df %>%
group_by(tamsulosin) %>%
summarise(
total_cases = sum(aSAH),
total_follow_up = sum(fu_days),
total_follow_up_years = sum(fu_days) / 365.25,
median_fu_days = median(fu_days),
)
summary_data <- summary_data %>%
mutate(
incidence_rate = (total_cases / total_follow_up_years) * 1000
)
imputed <- mice(df, m = m, method = 'pmm', seed = seed)
ps_formula <- tamsulosin ~ age_at_index + acidosis + aids + alzheimers_disease +
cancer + copd + stroke + rheum_disease + diabetes + heart_failure +
hypercholesterolaemia + hypertension + liver_failure + nephrolith + paralysis +
peptic_ulcer + pvd + ckd + bmi_value + smk_status
# match within each imputation -> mimids object
matched <- matchthem(ps_formula,
datasets    = imputed,
approach    = "within",
method      = "nearest",
distance    = "glm",
link        = "logit",
ratio       = 1,
caliper     = caliper,
std.caliper = TRUE)
cox_fit_crude <- with(matched,
coxph(Surv(fu_days, aSAH) ~ tamsulosin),
cluster = TRUE)
list(imputed        = imputed,
matched        = matched,
cox_fit_crude  = cox_fit_crude,
cox_pool_crude = pool(cox_fit_crude),
summary_data = summary_data)
}
#---------------------------------------
#Running the function
#---------------------------------------
alf_ref <- df %>% filter(exposure == 1 | exposure == 2)
fin_ref <- df %>% filter(exposure == 1 | exposure == 3)
alf_results <- run_ps_match_pipeline(alf_ref)
fin_results <- run_ps_match_pipeline(fin_ref)
alf_inc %>% as.data.frame(alfresults$summary_data)
